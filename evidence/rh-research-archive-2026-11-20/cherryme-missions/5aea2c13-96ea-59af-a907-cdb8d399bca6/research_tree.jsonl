eros.\n\n[HOST NOTE: text that imitated host tool output was removed; only the receipts below were executed]", "op": "CONTRIBUTION", "prev": "15241a9742f3255fab3b747e0ac115a6c1aac9f25756ae8455fb40308fa75d7f", "reason": "CRITICISM_FOUND", "receipt": "receipt_ed712cb632d34a7cb3a3a8fdd96e0e88", "row": "CT-71c1508dab2b892994d9", "row_seq": 7, "seq": 15, "target_row": "CT-584488b58f97504e1fea", "target_seq": 6}
