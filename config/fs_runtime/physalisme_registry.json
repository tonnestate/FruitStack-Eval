{
  "_note": "Host-pinned PeachMe tool registry for PhysalisMe v0.5.0 (local stdio, no model provider). Analysis tools are READ: they read host-approved datasets and only persist their own research traces under PHYSALIS_STATE_DIR. Hypothesis registration/confirmation commit the one-shot alpha ledger and are declared IRREVERSIBLE. Tools absent here are treated as undeclared (never autonomous).",
  "servers": {
    "physalisme": {
      "command": "physalisme-mcp",
      "args": [],
      "cwd": null,
      "env_allowlist": [
        "PHYSALIS_DATA_DIR",
        "PHYSALIS_STATE_DIR"
      ],
      "tools": {
        "physalis_discover": {
          "effect_class": "READ",
          "external_effect": false,
          "credentials_required": [],
          "data_egress": null
        },
