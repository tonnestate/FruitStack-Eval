          "data_egress": null
        },
        "physalis_correlations": {
          "effect_class": "READ",
          "external_effect": false,
          "credentials_required": [],
          "data_egress": null
        },
        "physalis_explore": {
          "effect_class": "READ",
          "external_effect": false,
